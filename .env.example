# =============================================================================
# NEXORA Environment Variables
# Copy to .env.local — NEVER commit real secrets
# =============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Nexora

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt-key

# xAI Grok → https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-2-latest

# OpenAI ChatGPT → https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini → https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENWEATHER_API_KEY=

# Optional transactional email via Resend (verified sender domain required)
RESEND_API_KEY=
NEXORA_EMAIL_FROM=
